{
  "name": "starfiniti/starfiniti-abandoned-cart",
  "description": "Abandoned cart recovery for WooCommerce: timed reminder e-mails, personal coupons and one-click cart restore.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/php-compatibility": "^9.3",
    "php-stubs/woocommerce-stubs": "10.8.1",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": {
      "Starfiniti\\AbandonedCart\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Starfiniti\\AbandonedCart\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "analyse": "phpstan analyse --no-progress --memory-limit=2G",
    "test": "phpunit",
    "check": [
      "@lint",
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
